MONGO_URL=your_mongodb_connection_string
PORT=5000
NODE_ENV=development
# Production: your live frontend origin(s), comma-separated (no trailing slash). Required for browser API calls.
# FRONTEND_URL=https://your-app.vercel.app
JWT_SECRET=your_jwt_secret_key
# Use a different, strong secret for refresh tokens in production.
JWT_REFRESH_SECRET=your_separate_refresh_token_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
OPENAI_API_KEY=your_openai_api_key
# Optional: Gmail (app password) for critical alerts and assignment emails
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_gmail_app_password

# Base URL used to build public complaint-tracking links (e.g. in emails/SMS)
PUBLIC_TRACKING_BASE_URL=http://localhost:5173

# Internal FastAPI AI service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=your_internal_fastapi_secret
AI_SERVICE_TIMEOUT_MS=10000


#For the super admin
SUPER_ADMIN_NAME=ReliefSync Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change_this_before_deployment


VOLUNTEER_OFFER_EXPIRY_MINUTES=15

#----------------------------------
# Spam screening policy (rule engine + ML model blend)
#----------------------------------
ML_SPAM_POLICY_ENABLED=false
ML_SPAM_REVIEW_THRESHOLD=0.80
ML_SPAM_BLOCK_THRESHOLD=0.98
ML_SPAM_RULE_BLOCK_THRESHOLD=0.80

#----------------------------------
# Semantic duplicate detection
#----------------------------------
SEMANTIC_DUPLICATE_ENABLED=true
SEMANTIC_DUPLICATE_LOOKBACK_HOURS=72
SEMANTIC_DUPLICATE_MAX_CANDIDATES=150
SEMANTIC_DUPLICATE_THRESHOLD=0.88

#----------------------------------
# Category/severity classification policy (rules + zero-shot model blend)
#----------------------------------
ML_CLASSIFICATION_POLICY_ENABLED=true
ML_CATEGORY_FALLBACK_THRESHOLD=0.80
ML_CATEGORY_CONFLICT_REVIEW_THRESHOLD=0.90
ML_SEVERITY_PROMOTION_THRESHOLD=0.75

#----------------------------------
# Backend-side caching of AI service calls (Redis)
#----------------------------------
BACKEND_REDIS_CACHE_ENABLED=true
BACKEND_REDIS_URL=redis://127.0.0.1:6379/0
BACKEND_REDIS_KEY_PREFIX=reliefsync:backend:v1
BACKEND_REDIS_CONNECT_TIMEOUT_MS=2000

AI_EXTRACTION_CACHE_TTL_SECONDS=21600
AI_PRIORITY_CACHE_TTL_SECONDS=21600
AI_SUMMARY_CACHE_TTL_SECONDS=21600

#----------------------------------
# Background task manager (BullMQ)
#----------------------------------
BULLMQ_ENABLED=true
BULLMQ_REDIS_URL=redis://127.0.0.1:6379/0
BULLMQ_PREFIX=reliefsync:jobs
BULLMQ_QUEUE_NAME=reliefsync-background

BULLMQ_WORKER_CONCURRENCY=2
BULLMQ_PRODUCER_MAX_RETRIES=1
BULLMQ_CONNECT_TIMEOUT_MS=2000

BULLMQ_JOB_ATTEMPTS=3
BULLMQ_BACKOFF_DELAY_MS=5000

#----------------------------------
# NGO offer expiry + redispatch
#----------------------------------
NGO_OFFER_EXPIRY_MINUTES=20
NGO_OFFER_EXPIRY_SWEEP_INTERVAL_MS=60000
NGO_OFFER_EXPIRY_BATCH_SIZE=100

NGO_DISPATCH_BATCH_SIZE=3
NGO_HIGH_SEVERITY_DISPATCH_BATCH_SIZE=5
NGO_CAPACITY_DEFAULT_MAX_ACTIVE_CASES=5
NGO_DISPATCH_LOCK_SECONDS=45

#----------------------------------
# Notifications
#----------------------------------
NOTIFICATION_DEFAULT_CHANNEL=CONSOLE
NOTIFICATION_CONSOLE_ENABLED=true
NOTIFICATION_NGO_OFFER_ENABLED=true
NOTIFICATION_VOLUNTEER_OFFER_ENABLED=true

# Retries queuing notifications stuck at QUEUED after a transient Redis outage
NOTIFICATION_REQUEUE_SWEEP_INTERVAL_MS=120000
NOTIFICATION_REQUEUE_GRACE_MS=60000
NOTIFICATION_REQUEUE_BATCH_SIZE=100

#----------------------------------
# Escalation handling
#----------------------------------
ESCALATION_ENABLED=true
ESCALATION_QUEUE_NAME=reliefsync-escalation
ESCALATION_SWEEP_INTERVAL_MS=60000
ESCALATION_BATCH_SIZE=100
ESCALATION_INITIAL_GRACE_MINUTES=2
