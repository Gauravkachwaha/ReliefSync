AI_SERVICE_API_KEY=your_internal_fastapi_secret

SPAM_MODEL_NAME=mrm8488/bert-tiny-finetuned-sms-spam-detection
SPAM_MODEL_ENABLED=true
SPAM_MODEL_SPAM_LABEL=LABEL_1

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_MODEL_ENABLED=true

# Classification model
COMPLAINT_CLASSIFIER_MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
COMPLAINT_CLASSIFIER_ENABLED=true

# OpenAI-backed extraction + classification (optional — falls back to
# rule-based extraction if unset/unavailable)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EXTRACTION_ENABLED=true
OPENAI_CLASSIFIER_ENABLED=true

#----------------------------------
# Model-output caching (Redis)
#----------------------------------
REDIS_CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=reliefsync:ai:v1

REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CACHE_DEFAULT_TTL_SECONDS=3600

SPAM_CACHE_TTL_SECONDS=86400
CLASSIFIER_CACHE_TTL_SECONDS=86400
EMBEDDING_CACHE_TTL_SECONDS=604800
